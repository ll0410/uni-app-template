{
  "name": "uni-app-template",
  "version": "0.1.0",
  "private": true,
  "description": "通用 uni-app + Vue3 + TypeScript + Vite 项目模板",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=20.19.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev:h5": "uni",
    "dev:h5:test": "uni --mode test",
    "dev:mp-weixin": "uni -p mp-weixin",
    "dev:app": "uni -p app",
    "build:h5": "uni build",
    "build:h5:test": "uni build --mode test",
    "build:mp-weixin": "uni build -p mp-weixin",
    "build:mp-weixin:test": "uni build -p mp-weixin --mode test",
    "build:app": "uni build -p app",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:style": "stylelint \"src/**/*.{vue,scss,css}\"",
    "lint:style:fix": "stylelint \"src/**/*.{vue,scss,css}\" --fix",
    "format": "prettier --write .",
    "type-check": "vue-tsc --noEmit -p tsconfig.json",
    "prepare": "husky"
  },
  "dependencies": {
    "@dcloudio/uni-app": "3.0.0-5030420261029002",
    "@dcloudio/uni-app-plus": "3.0.0-5030420261029002",
    "@dcloudio/uni-components": "3.0.0-5030420261029002",
    "@dcloudio/uni-h5": "3.0.0-5030420261029002",
    "@dcloudio/uni-mp-weixin": "3.0.0-5030420261029002",
    "pinia": "2.3.1",
    "pinia-plugin-persistedstate": "3.2.3",
    "vue": "3.4.21",
    "vue-i18n": "9.14.5"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@dcloudio/types": "3.4.31",
    "@dcloudio/vite-plugin-uni": "3.0.0-5030420261029002",
    "@eslint/js": "10.0.1",
    "@intlify/unplugin-vue-i18n": "5.3.1",
    "@types/node": "^22.10.0",
    "@vue/tsconfig": "0.9.1",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-vue": "10.12.0",
    "globals": "17.14.0",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "postcss": "8.5.32",
    "postcss-html": "2.0.0",
    "prettier": "3.9.10",
    "sass": "1.77.8",
    "stylelint": "17.16.0",
    "stylelint-config-html": "2.0.0",
    "stylelint-config-recommended": "18.0.0",
    "stylelint-config-recommended-vue": "2.0.0",
    "stylelint-config-standard-scss": "17.0.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "unplugin-auto-import": "19.1.0",
    "vite": "5.2.8",
    "vue-eslint-parser": "10.4.2",
    "vue-tsc": "3.3.14"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.vue": [
      "eslint --fix",
      "stylelint --fix",
      "prettier --write"
    ],
    "*.{css,scss}": [
      "stylelint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "pnpm": {
    "overrides": {
      "@intlify/message-compiler": "9.14.5",
      "@intlify/shared": "9.14.5"
    },
    "onlyBuiltDependencies": [
      "core-js",
      "core-js-pure",
      "esbuild",
      "vue-demi"
    ]
  }
}
